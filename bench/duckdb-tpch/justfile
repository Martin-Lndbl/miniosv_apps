set shell := ["bash", "-euo", "pipefail", "-c"]

# The bucket, the subnet and the VPC gateway endpoint are smoltcp-s3's, not
# this bench's: a mininet-backed image only ever dials one host (see
# PLAN_duckdb_net.md §6, "One endpoint per image"), so TPC-H data goes in the
# same bucket under its own prefix. scripts/bench-setup.sh owns loading that
# .env, logging in and granting the endpoint a read; what is left here is the
# part only this bench knows -- which scale factors to generate and where to
# put them.
common := justfile_directory() / "../../../scripts/bench-setup.sh"

# List available recipes
default:
    @just --list

# Generate TPC-H at one or more scale factors and upload each to
# s3://$AWS_BUCKET/tpch/sf<N>/<table>.parquet, granted to the VPC gateway
# endpoint under its own Sid per scale factor so none of them, or
# smoltcp-s3's own grant, clobber each other.
#
#   just setup apps/bench/duckdb-tpch          # sf=1
#   just setup apps/bench/duckdb-tpch 0.1      # smaller, faster to iterate on
#   just setup apps/bench/duckdb-tpch 1,0.1,0.01   # all three, one call
setup sfs="1":
    #!/usr/bin/env bash
    set -euo pipefail

    . "{{ common }}"
    bench_env_load bootstrap
    bench_login

    IFS=',' read -ra sf_list <<< "{{ sfs }}"
    for sf in "${sf_list[@]}"; do
        prefix="tpch/sf${sf}"

        tmpdir=$(mktemp -d)
        trap 'rm -rf "$tmpdir"' EXIT

        # A throwaway duckdb, not the miniOSv build: this one only has to run
        # on the host and know the tpch extension. dbgen writes into an
        # in-memory database; EXPORT DATABASE dumps every table as
        # <table>.parquet.
        echo "generating TPC-H sf=$sf..."
        nix run nixpkgs#duckdb -- \
            -c "INSTALL tpch; LOAD tpch; CALL dbgen(sf=$sf); EXPORT DATABASE '$tmpdir' (FORMAT PARQUET);"

        for table in customer lineitem nation orders part partsupp region supplier; do
            echo "uploading $table.parquet"
            aws s3 cp "$tmpdir/$table.parquet" "s3://$AWS_BUCKET/$prefix/$table.parquet" --only-show-errors
        done
        rm -rf "$tmpdir"
        trap - EXIT

        # Merged by Sid, same as smoltcp-s3's own grant: both read from this
        # bucket, and a second scale factor's grant doesn't touch the first's.
        bench_grant "TpchSf${sf//./_}FromVpce" "arn:aws:s3:::$AWS_BUCKET/$prefix/*"

        echo
        echo "tpch sf=$sf ready:"
        echo "  s3://$AWS_BUCKET/$prefix/<table>.parquet"
        echo "  https://$AWS_BUCKET.s3.$AWS_REGION.amazonaws.com/$prefix/<table>.parquet"
        echo
    done

# Remove one or more scale factors' objects and bucket-policy grants (not the bucket itself)
#   just clean apps/bench/duckdb-tpch 0.1,0.01
clean sfs="1":
    #!/usr/bin/env bash
    set -euo pipefail

    . "{{ common }}"
    bench_env_load

    IFS=',' read -ra sf_list <<< "{{ sfs }}"
    for sf in "${sf_list[@]}"; do
        aws s3 rm "s3://$AWS_BUCKET/tpch/sf${sf}/" --recursive
        bench_revoke "TpchSf${sf//./_}FromVpce"
    done
